{
  "expo": {
    "name": "Shieldy",
    "slug": "shieldy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/shieldy-app-icon.png",
    "scheme": "shieldy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/shieldy-app-icon.png"
    },
    "android": {
      "package": "com.shieldy.app",
      "adaptiveIcon": {
        "backgroundColor": "#DDF2FC",
        "foregroundImage": "./assets/images/shieldy-android-foreground.png",
        "monochromeImage": "./assets/images/shieldy-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DDF2FC",
          "image": "./assets/images/shieldy-logo-transparent.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "94898ebe-1b17-4d0e-ab06-f804732fd9ad"
      }
    }
  }
}
